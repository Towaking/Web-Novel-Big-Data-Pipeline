# TLS to MinIO for every Spark/Python container (certificates from certs-init).
MINIO_ENDPOINT=https://minio:9000
# botocore (boto3, pandas via storage.py) verifies the server against the stack CA.
AWS_CA_BUNDLE=/certs/ca.crt
# Every JVM in the container (driver, master, worker, executors) trusts the stack CA.
JAVA_TOOL_OPTIONS=-Djavax.net.ssl.trustStore=/certs/truststore.p12 -Djavax.net.ssl.trustStorePassword=changeit -Djavax.net.ssl.trustStoreType=PKCS12
