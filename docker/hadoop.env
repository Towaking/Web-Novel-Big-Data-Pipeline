# Konfigurasi klaster Hadoop (HDFS + YARN/MapReduce).
#
# Image apache/hadoop menerjemahkan variabel berpola <BERKAS>_<properti>=<nilai>
# menjadi core-site.xml / hdfs-site.xml / mapred-site.xml / yarn-site.xml saat
# container start, jadi tidak ada berkas XML yang perlu dipelihara.

# HDFS -------------------------------------------------------------
CORE-SITE.XML_fs.defaultFS=hdfs://namenode:8020
CORE-SITE.XML_fs.default.name=hdfs://namenode:8020
HDFS-SITE.XML_dfs.namenode.rpc-address=namenode:8020
HDFS-SITE.XML_dfs.namenode.http-address=namenode:9870
HDFS-SITE.XML_dfs.webhdfs.enabled=true

# Replikasi 2 = setiap blok punya dua salinan di DataNode berbeda. Inilah
# fault tolerance HDFS: satu DataNode boleh mati tanpa data hilang. Dengan
# dua DataNode, 2 adalah nilai tertinggi yang bermakna.
HDFS-SITE.XML_dfs.replication=2

# Batas bawah ukuran blok dilonggarkan supaya load_hdfs.sh dapat memakai blok 4 MB.
# Dataset ini hanya ~60 MB; dengan blok bawaan 128 MB setiap berkas cuma satu blok
# dan tidak ada yang terpecah. Di produksi biarkan 128 MB.
HDFS-SITE.XML_dfs.namenode.fs-limits.min-block-size=1048576

# MapReduce di atas YARN ------------------------------------------
MAPRED-SITE.XML_mapreduce.framework.name=yarn
MAPRED-SITE.XML_yarn.app.mapreduce.am.env=HADOOP_MAPRED_HOME=/opt/hadoop
MAPRED-SITE.XML_mapreduce.map.env=HADOOP_MAPRED_HOME=/opt/hadoop
MAPRED-SITE.XML_mapreduce.reduce.env=HADOOP_MAPRED_HOME=/opt/hadoop
MAPRED-SITE.XML_mapreduce.map.memory.mb=512
MAPRED-SITE.XML_mapreduce.reduce.memory.mb=512
MAPRED-SITE.XML_yarn.app.mapreduce.am.resource.mb=512

# YARN -------------------------------------------------------------
YARN-SITE.XML_yarn.resourcemanager.hostname=resourcemanager
YARN-SITE.XML_yarn.nodemanager.aux-services=mapreduce_shuffle
# BUKAN default (di bawah $HADOOP_TMP_DIR = /tmp/hadoop-hadoop): direktori itu
# adalah induk dari mount point volume DataNode (dfs/data), dan Docker membuat
# induk mount sebagai root:root - proses NodeManager (user `hadoop`) tidak bisa
# membuat direktori BARU di situ ("nm-local-dir: Permission denied"). `/tmp`
# sendiri sticky-bit (drwxrwxrwt), jadi taruh langsung di situ, sejajar dengan
# `/tmp/hadoop-hadoop`, bukan di bawahnya.
YARN-SITE.XML_yarn.nodemanager.local-dirs=/tmp/nm-local-dir
YARN-SITE.XML_yarn.nodemanager.log-dirs=/tmp/nm-log-dir
YARN-SITE.XML_yarn.nodemanager.resource.memory-mb=2048
YARN-SITE.XML_yarn.nodemanager.resource.cpu-vcores=2
YARN-SITE.XML_yarn.scheduler.minimum-allocation-mb=256
# Cek memori fisik/virtual dimatikan: dalam container, YARN salah membaca
# memori host dan membunuh task yang sebenarnya sehat.
YARN-SITE.XML_yarn.nodemanager.pmem-check-enabled=false
YARN-SITE.XML_yarn.nodemanager.vmem-check-enabled=false
YARN-SITE.XML_yarn.log-aggregation-enable=false
# Antrian minimal. `-D<berkas>.xml_<properti>=<nilai>` MENGGANTI seluruh
# capacity-scheduler.xml bawaan (bukan menambal), jadi root.queues dan properti
# tiap antrian harus dituliskan eksplisit di sini - tanpanya ResourceManager
# gagal start dengan "Queue configuration missing child queue names for root".
CAPACITY-SCHEDULER.XML_yarn.scheduler.capacity.root.queues=default
CAPACITY-SCHEDULER.XML_yarn.scheduler.capacity.root.capacity=100
CAPACITY-SCHEDULER.XML_yarn.scheduler.capacity.root.default.capacity=100
CAPACITY-SCHEDULER.XML_yarn.scheduler.capacity.root.default.maximum-capacity=100
CAPACITY-SCHEDULER.XML_yarn.scheduler.capacity.root.default.state=RUNNING
CAPACITY-SCHEDULER.XML_yarn.scheduler.capacity.root.default.user-limit-factor=1
CAPACITY-SCHEDULER.XML_yarn.scheduler.capacity.maximum-am-resource-percent=0.5
CAPACITY-SCHEDULER.XML_yarn.scheduler.capacity.root.default.maximum-am-resource-percent=0.5
CAPACITY-SCHEDULER.XML_yarn.scheduler.capacity.resource-calculator=org.apache.hadoop.yarn.util.resource.DominantResourceCalculator
