# Konfigurasi environment pipeline (copy file ini menjadi .env)

# Image tags
MINIO_IMAGE_TAG=latest
MC_IMAGE_TAG=latest

# MinIO (Object Storage / Data Lake)
# Kredensial root: dipakai minio-init dan service yang menulis ke lake.
# WAJIB diganti sebelum stack ini diekspos ke jaringan mana pun — audit
# `governance_audit.py` menandainya PERINGATAN (SEC-01) selama masih bawaan.
MINIO_ROOT_USER=change-me-admin
MINIO_ROOT_PASSWORD=change-me-long-random-password

# Akun read-only untuk dashboard (least privilege, kontrol SEC-04).
# Dibuat otomatis oleh minio-init beserta policy `novel-readonly`.
MINIO_READONLY_USER=novel-dashboard
MINIO_READONLY_PASSWORD=change-me-another-long-random-password
MINIO_ENDPOINT=https://minio:9000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Bucket layout (medallion-style)
BUCKET_RAW=raw-data          # Fase 1  : CSV mentah
BUCKET_CLEAN=clean-data      # Fase 2-3: Parquet hasil cleaning
BUCKET_CURATED=curated-data  # Fase 3-4: hasil agregasi & artefak model

# Spark
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_MASTER_UI_PORT=7080
SPARK_WORKER_UI_PORT=7081        # awal rentang host-port worker (mendukung --scale)
SPARK_WORKER_UI_PORT_END=7085    # akhir rentang - HARUS ikut berubah bersama baris di atas
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=3G
SPARK_DRIVER_MEMORY=2G
SPARK_EXECUTOR_MEMORY=2G
SPARK_SHUFFLE_PARTITIONS=8

# Streamlit
STREAMLIT_PORT=8501

# Notebook
JUPYTER_PORT=8888
# Kosongkan untuk akses tanpa token (hanya aman untuk lokal)
JUPYTER_TOKEN=

# Hadoop (HDFS + YARN/MapReduce)
HADOOP_IMAGE_TAG=3.3.6
HDFS_UI_PORT=9870
# BUKAN 8088 bawaan Hadoop: pada Windows port itu sering jatuh di rentang yang
# direservasi Hyper-V/WSL untuk NAT dinamis (cek dengan
# `netsh interface ipv4 show excludedportrange protocol=tcp`), dan Docker
# gagal bind dengan pesan yang tidak jelas. 18088 di luar rentang itu.
YARN_UI_PORT=18088

# Dataset
SOURCE_CSV=Dataset/novel_catalogue.csv
RAW_OBJECT_KEY=novel/novel_catalogue.csv

# Logging
LOG_LEVEL=INFO

# Encoder kalimat pralatih (Head A arsitektur `hybrid`)
# Nama model harus SAMA dengan yang di-bake Dockerfile; mengubahnya di sini
# saja akan membuat inferensi mencari bobot yang tidak ada di dalam image.
SENTENCE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Jumlah thread PyTorch khusus encoder. Image membatasi OMP_NUM_THREADS=2 untuk
# mencegah deadlock OpenBLAS<->JVM Spark; batas itu membuat encoding 4.460
# dokumen makan belasan menit. Naikkan bila host punya banyak core — hanya
# PyTorch yang terpengaruh, OpenBLAS tidak tersentuh.
ENCODER_THREADS=4

# Interface the host ports listen on. 127.0.0.1 keeps every UI (Jupyter has no
# token) on this machine; publish the dashboard through a tunnel to localhost:8501.
HOST_BIND=127.0.0.1

# 1 on a published deployment: hides the Dataset and Lake Operations pages and
# raw error text. Leave 0 for local work.
NOVELLENS_PUBLIC=0
