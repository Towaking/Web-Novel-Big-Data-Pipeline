# ============================================================
# Konfigurasi environment pipeline (copy file ini menjadi .env)
# ============================================================

# --- Image tags ---
MINIO_IMAGE_TAG=latest
MC_IMAGE_TAG=latest

# --- MinIO (Object Storage / Data Lake) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=http://minio:9000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Bucket layout (medallion-style) ---
BUCKET_RAW=raw-data          # Fase 1  : CSV mentah
BUCKET_CLEAN=clean-data      # Fase 2-3: Parquet hasil cleaning
BUCKET_CURATED=curated-data  # Fase 3-4: hasil agregasi & artefak model

# --- Spark ---
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_MASTER_UI_PORT=8080
SPARK_WORKER_UI_PORT=8081        # awal rentang host-port worker (8081-8085), mendukung --scale
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=3G
SPARK_DRIVER_MEMORY=2G
SPARK_EXECUTOR_MEMORY=2G
SPARK_SHUFFLE_PARTITIONS=8

# --- Streamlit ---
STREAMLIT_PORT=8501

# --- Notebook ---
JUPYTER_PORT=8888
# Kosongkan untuk akses tanpa token (hanya aman untuk lokal)
JUPYTER_TOKEN=

# --- Dataset ---
SOURCE_CSV=Dataset/data_novel.csv
SOURCE_SYNOPSIS_CSV=Dataset/novel_dataset_scrapped.csv
RAW_OBJECT_KEY=novel/data_novel.csv
RAW_SYNOPSIS_OBJECT_KEY=novel/novel_dataset_scrapped.csv

# --- Logging ---
LOG_LEVEL=INFO

# --- Encoder kalimat pralatih (Head A arsitektur `hybrid`) ---
# Nama model harus SAMA dengan yang di-bake Dockerfile; mengubahnya di sini
# saja akan membuat inferensi mencari bobot yang tidak ada di dalam image.
SENTENCE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Jumlah thread PyTorch khusus encoder. Image membatasi OMP_NUM_THREADS=2 untuk
# mencegah deadlock OpenBLAS<->JVM Spark; batas itu membuat encoding 4.460
# dokumen makan belasan menit. Naikkan bila host punya banyak core — hanya
# PyTorch yang terpengaruh, OpenBLAS tidak tersentuh.
ENCODER_THREADS=4
